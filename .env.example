# Cấu hình chạy cả hệ thống bằng Docker: cp .env.example .env && docker compose up --build
# Giá trị dưới đây chỉ để chạy thử trên máy cá nhân, KHÔNG dùng khi triển khai thật.
# Không commit file .env (đã nằm trong .gitignore). Biến để trống = tắt tính năng tương ứng.

# ---------------------------------------------------------------------------------------------------------------------
# Cơ sở dữ liệu
# ---------------------------------------------------------------------------------------------------------------------
# Mật khẩu root của MySQL (BE kết nối bằng user root tới database music_db). Flyway tự tạo bảng và nạp dữ liệu mẫu
MYSQL_ROOT_PASSWORD=change_me

# ---------------------------------------------------------------------------------------------------------------------
# Bảo mật
# ---------------------------------------------------------------------------------------------------------------------
# Khoá ký JWT, tối thiểu 64 ký tự (thuật toán HS512). Tạo khoá thật: openssl rand -hex 64
JWT_SIGNER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Thời hạn access token (giờ) và thời hạn được làm mới token (giờ)
JWT_VALID_DURATION=7
JWT_REFRESHABLE_DURATION=24
# Khoá bí mật dùng chung giữa music-be (AI_INTERNAL_KEY) và music-ai (INTERNAL_KEY): hai bên phải giống nhau
AI_INTERNAL_KEY=change_me_internal_key

# ---------------------------------------------------------------------------------------------------------------------
# Email (gửi OTP, lời mời vào nhóm, nhắc gói sắp hết hạn)
# ---------------------------------------------------------------------------------------------------------------------
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password) dùng làm MAIL_PASSWORD
MAIL_USERNAME=demo@example.com
MAIL_PASSWORD=change_me

# ---------------------------------------------------------------------------------------------------------------------
# Đăng nhập Google (để trống = ẩn nút đăng nhập Google)
# ---------------------------------------------------------------------------------------------------------------------
# Client ID loại Web: dùng cho cả BE (kiểm tra token) và web (nút đăng nhập)
GOOGLE_CLIENT_ID=
# Client ID của ứng dụng di động, chỉ cần khi có app iOS / Android
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---------------------------------------------------------------------------------------------------------------------
# Cloudinary (lưu ảnh đại diện)
# ---------------------------------------------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# Thanh toán VNPay (môi trường thử, để trống = tắt mua gói)
# ---------------------------------------------------------------------------------------------------------------------
# Lấy ở trang đăng ký sandbox của VNPay. Khoá chỉ đặt ở đây, không ghi vào file cấu hình trong git
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Trang VNPay đưa người dùng về sau khi thanh toán; đổi cổng WEB_PORT thì đổi cả địa chỉ này
VNPAY_RETURN_URL=http://localhost:5173/billing/result
# IPN (VNPay gọi về BE để báo kết quả) phải là địa chỉ công khai: https://<máy chủ>/api/payments/vnpay/ipn,
# đăng ký trong trang quản trị sandbox của VNPay. Chạy trên máy cá nhân thì dùng ngrok hoặc tương tự

# ---------------------------------------------------------------------------------------------------------------------
# Địa chỉ web và cổng
# ---------------------------------------------------------------------------------------------------------------------
# Địa chỉ người dùng mở web: dùng dựng link trong email (lời mời vào nhóm...)
APP_WEB_URL=http://localhost:5173
# Cổng mở ra máy chủ. Web phải ở 5173 vì BE chỉ cho CORS từ http://localhost:5173
WEB_PORT=5173
BE_PORT=8080
