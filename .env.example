# Sao chép thành .env rồi chỉnh. Giá trị dưới đây chỉ để chạy thử, KHÔNG dùng khi triển khai thật.
MYSQL_ROOT_PASSWORD=change_me
# Tối thiểu 64 ký tự (thuật toán HS512). Tạo khoá thật: openssl rand -hex 64
JWT_SIGNER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Dùng chung cho music-be (AI_INTERNAL_KEY) và music-ai (INTERNAL_KEY)
AI_INTERNAL_KEY=change_me_internal_key
MAIL_USERNAME=demo@example.com
MAIL_PASSWORD=change_me
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cổng mở ra máy chủ. Web phải ở 5173 vì BE chỉ cho CORS từ http://localhost:5173
WEB_PORT=5173
BE_PORT=8080
