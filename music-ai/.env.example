# Cấu hình music-ai (nhận diện bản nhạc OMR): cp .env.example .env rồi chạy: uvicorn app.main:app --env-file .env
# Chạy bằng Docker thì dùng .env ở thư mục gốc của repo (docker-compose.yml truyền các biến cần thiết).
# Dòng bắt đầu bằng # là giá trị mặc định, bỏ # và sửa khi cần.

# ---------------------------------------------------------------------------------------------------------------------
# Kết nối với music-be (bắt buộc)
# ---------------------------------------------------------------------------------------------------------------------
# Khóa bí mật dùng chung, PHẢI giống biến AI_INTERNAL_KEY của music-be
INTERNAL_KEY=dev-internal-key
# Địa chỉ music-be để gọi callback báo kết quả
JAVA_BASE_URL=http://localhost:8080
# Thư mục storage dùng chung với music-be (mặc định ../music-be/storage so với thư mục gốc repo)
# STORAGE_ROOT=/duong/dan/den/music/music-be/storage
# Gọi callback lại bao nhiêu lần khi lỗi, và chờ tối đa bao nhiêu giây cho mỗi lần
# CALLBACK_RETRIES=3
# CALLBACK_TIMEOUT_S=10

# ---------------------------------------------------------------------------------------------------------------------
# Giới hạn và thời gian chờ
# ---------------------------------------------------------------------------------------------------------------------
# Giây tối đa cho cả một task, cho tiền xử lý mỗi trang, và số task chờ trong hàng đợi
# TASK_TIMEOUT_S=600
# PAGE_TIMEOUT_S=90
# QUEUE_MAX=50
# Số trang PDF tối đa mỗi task
# MAX_PAGES=40
# Độ phân giải khi đổi PDF thành ảnh, và cạnh dài tối đa của ảnh (px)
# PDF_DPI=300
# MAX_SIDE_PX=3600

# ---------------------------------------------------------------------------------------------------------------------
# Model nhận diện Transcoda
# ---------------------------------------------------------------------------------------------------------------------
# Nạp model khi khởi động (false: chỉ chạy tiền xử lý, không cần torch)
# LOAD_MODEL=true
# Tên repo trên Hugging Face, hoặc thư mục model đã tải về (xem README)
# MODEL_ID=btrkeks/transcoda-59M-zeroshot-v1
# MODEL_ID=models/transcoda
# auto (cuda nếu có, ngược lại cpu) | cpu | cuda | mps
# DEVICE=auto
# 1 = greedy (nhanh), 3 = beam search như bài báo (chậm hơn nhiều)
# NUM_BEAMS=1
# Số token tối đa mỗi lần đọc và hệ số phạt lặp
# MAX_TOKENS=2048
# REPETITION_PENALTY=1.1
# Chạy CPU chậm thì tăng hạn cho mỗi trang (nhận diện) và thời gian chờ nạp model
# INFERENCE_PAGE_TIMEOUT_S=90
# MODEL_WAIT_S=600

# ---------------------------------------------------------------------------------------------------------------------
# Ghép kết quả (kern -> bản nhạc)
# ---------------------------------------------------------------------------------------------------------------------
# fail: kern ghép mà music21 không đọc được thì task FAILED | warn: chỉ cảnh báo
# KERN_PARSE_MODE=fail
# Cho phép ghép khi số spine giữa các hệ lệch nhau, và số dòng lặp liên tiếp tối đa trước khi coi là model đọc lặp
# MERGE_LENIENT_SPINES=true
# MAX_REPEAT_LINES=24

# ---------------------------------------------------------------------------------------------------------------------
# Bố cục và nhận diện lại theo hệ (bản giọng hát + piano)
# ---------------------------------------------------------------------------------------------------------------------
# off | fallback (chỉ nhận diện lại trang sai số khuông hoặc lệch số ô) | always (để đo, chậm gấp đôi)
# OMR_ROUTING=fallback
# 1: dùng số ô đếm trên ảnh (vạch nhịp) để phát hiện model đọc lặp và chọn lần đọc đúng số ô; 0: tắt (để so sánh)
# OMR_ROUTING_BARS=1
# 1: trang đúng số spine nhưng lệch trường độ ô nhịp cũng nhận diện lại theo hệ (chậm hơn)
# OMR_ROUTING_MEASURES=0
# Hệ vẫn sai số khuông thì thử lại bằng beam search với số beam này (0 hoặc 1: không thử lại)
# ROUTING_RETRY_BEAMS=3
# Giây giữ lại cho bước ghép và xuất; nhận diện lại không bao giờ làm job quá hạn
# ROUTING_RESERVE_S=30
