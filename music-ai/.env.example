# Sao chép thành .env rồi chạy: uvicorn app.main:app --env-file .env
# Khóa bí mật dùng chung, PHẢI giống biến môi trường AI_INTERNAL_KEY của Spring Boot
INTERNAL_KEY=dev-internal-key

# Địa chỉ Spring Boot để gọi callback
JAVA_BASE_URL=http://localhost:8080

# Gốc thư mục storage dùng chung với Spring Boot (mặc định: ../music-be/storage so với thư mục music-ai)
# STORAGE_ROOT=/Users/ban/Project/music/music-be/storage

# Tùy chọn (giá trị mặc định)
# TASK_TIMEOUT_S=600
# PAGE_TIMEOUT_S=90
# PDF_DPI=300
# MAX_SIDE_PX=3600
# QUEUE_MAX=50

# --- Nhận diện bằng Transcoda ---
# Nạp model khi khởi động (false: chỉ chạy tiền xử lý, không cần torch)
# LOAD_MODEL=true
# Tên repo trên Hugging Face, hoặc thư mục model đã tải về (xem README)
# MODEL_ID=btrkeks/transcoda-59M-zeroshot-v1
# MODEL_ID=models/transcoda
# auto (cuda nếu có, ngược lại cpu) | cpu | cuda | mps
# DEVICE=auto
# 1 = greedy (nhanh), 3 = beam search như bài báo (chậm hơn nhiều)
# NUM_BEAMS=1
# Chạy CPU chậm thì tăng hạn cho mỗi trang và cho cả job
# INFERENCE_PAGE_TIMEOUT_S=90
# TASK_TIMEOUT_S=600
# fail: kern ghép mà music21 không đọc được thì task FAILED | warn: chỉ cảnh báo
# KERN_PARSE_MODE=fail

# --- Bố cục và nhận diện lại theo hệ (bản giọng hát + piano) ---
# off | fallback (chỉ nhận diện lại trang sai số khuông) | always (để đo)
# OMR_ROUTING=fallback
# Hệ vẫn sai số khuông thì thử lại bằng beam search với số beam này (0/1: không thử lại)
# OMR_ROUTING_MEASURES=0
# ROUTING_RETRY_BEAMS=3
# Giây giữ lại cho bước ghép/xuất; nhận diện lại không bao giờ làm job quá hạn
# ROUTING_RESERVE_S=30
